# Optional build-time overrides for brand/commerce.ts.
#
# Useful for pointing a preview deploy at staging without editing the brand
# layer. Both are read by src/lib/commerce.ts and fall back to the values in
# brand/commerce.ts when unset. Neither has any effect while demo.enabled is
# true, because demo mode never makes a request.

# PUBLIC_API_BASE=https://commerce-workers.example.workers.dev
# PUBLIC_SITE_DOMAIN=my-shop-staging.pages.dev
