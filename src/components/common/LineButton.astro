---
/**
 * The LINE sign-in button — the mark, the label, and nothing else.
 *
 * It exists as a component because two surfaces need it (the login page and
 * the checkout member wall) and the mark is 1.5KB of path data. A second copy
 * of that is a second thing to fix when the channel changes its logo.
 *
 * `hook` is the data-attribute the page's script listens on, passed rather than
 * hardcoded: the two surfaces send a member to different places afterwards
 * (/account vs back to /checkout), and that destination belongs to the page,
 * not to the button.
 */
import { member } from "../../../brand/copy";

interface Props {
  /** e.g. "data-line-login". Rendered as a bare attribute for the page script. */
  hook: string;
}

const { hook } = Astro.props;
---

<button type="button" class="line-button" {...{ [hook]: true }}>
  <svg class="line-mark" viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M12 3.2c-5.13 0-9.3 3.4-9.3 7.58 0 3.75 3.3 6.89 7.78 7.48.3.07.71.2.82.46.1.24.06.6.03.85l-.13.79c-.4.23-.19.92.8.52.99-.4 5.35-3.15 7.3-5.39 1.35-1.48 1.99-2.98 1.99-4.71 0-4.18-4.17-7.58-9.29-7.58Z"></path>
    <path fill="var(--color-line)" d="M8.2 8.95h-.65a.18.18 0 0 0-.18.18v4.05c0 .1.08.18.18.18h.65c.1 0 .18-.08.18-.18V9.13a.18.18 0 0 0-.18-.18Zm4.49 0h-.65a.18.18 0 0 0-.18.18v2.41l-1.86-2.51-.01-.02-.01-.01h-.72a.18.18 0 0 0-.18.18v4.05c0 .1.08.18.18.18h.65c.1 0 .18-.08.18-.18v-2.4l1.86 2.51.4.04h.7c.1 0 .18-.08.18-.18V9.13a.18.18 0 0 0-.18-.18Zm-5.94 3.4H5.03V9.13a.18.18 0 0 0-.18-.18H4.2a.18.18 0 0 0-.18.18v4.05c0 .05.02.09.05.12.03.03.08.05.13.05h2.55c.1 0 .18-.08.18-.18v-.65a.18.18 0 0 0-.18-.18Zm9.96-3.4h-2.55a.18.18 0 0 0-.18.18v4.05c0 .1.08.18.18.18h2.55c.1 0 .18-.08.18-.18v-.65a.18.18 0 0 0-.18-.18h-1.72v-.66h1.72c.1 0 .18-.08.18-.18v-.65a.18.18 0 0 0-.18-.18h-1.72v-.67h1.72c.1 0 .18-.08.18-.18v-.65a.18.18 0 0 0-.18-.18Z"></path>
  </svg>
  <span>{member.loginButton}</span>
</button>

<style>
  /* LINE's own green, from brand/identity.ts. This button belongs to the
     channel, not to the shop — dressing it in the brand's accent would
     misrepresent whose login it is. */
  .line-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    min-height: 52px;
    margin-top: var(--space-2);
    padding: 14px 24px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-line);
    color: var(--color-on-dark);
    font: inherit;
    font-size: var(--body-text-size);
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  /* The mark is inlined rather than pulled from brand/assets, because this is
     the one ground it has to be reversed out on: the bubble takes the button's
     ink and the letters are punched back out in the green behind them. A CSS
     filter cannot do that — it flattens both paths to one colour and the word
     LINE disappears. */
  .line-mark {
    width: 22px;
    height: 22px;
    flex: none;
  }
</style>
