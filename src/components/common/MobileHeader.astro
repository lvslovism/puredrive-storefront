---
/**
 * The narrow-screen drawer — the navigation, and nothing else.
 *
 * The cart and the member link used to be duplicated in here because the
 * header hid its whole tool cluster below 980px. It no longer does: the
 * cluster drops its labels and stays, so this is the one control the header
 * cannot fit at that width, and a shop with no navigation never renders it at
 * all. The header decides that and passes the already-filtered list down —
 * a second `visibleLinks` call here would be a second place to forget.
 */
import type { NavItem } from "../../../brand/copy";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

{/* <details> drawer: open/close is the browser's, so the menu works before —
    and without — any JavaScript. */}
<details class="mobile-nav" data-section="mobile-header">
  <summary aria-label="選單">
    <span></span>
    <span></span>
    <span></span>
  </summary>
  <nav aria-label="行動版選單">
    {items.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</details>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 980px) {
    .mobile-nav {
      display: block;
    }

    summary {
      display: flex;
      width: 34px;
      height: 34px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border: 1px solid var(--color-border);
      border-radius: 50%;
      background: var(--color-header-bg);
      color: var(--text-secondary);
      list-style: none;
      cursor: pointer;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary span {
      display: block;
      width: 16px;
      height: 1px;
      background: currentColor;
    }

    nav {
      position: absolute;
      right: 16px;
      left: 16px;
      top: 60px;
      display: grid;
      gap: var(--space-2);
      padding: var(--space-4);
      border: 1px solid var(--color-border);
      background: var(--color-header-bg);
    }

    nav a {
      padding-block: 10px;
      border-bottom: 1px solid var(--color-mist);
      color: var(--text-primary);
      font-size: var(--description-text-size);
      letter-spacing: var(--nav-letter-spacing);
      line-height: 20px;
    }
  }
</style>
