---
import { formatMoney } from "../../../brand/identity";

interface CartProduct {
  slug: string;
  name: string;
  image: string;
  price: number;
  quantity: number;
  note?: string;
}

interface Props {
  item: CartProduct;
}

const { item } = Astro.props;
const subtotal = item.price * item.quantity;
---

<article class="cart-row" data-cart-row>
  <a class="cart-product-link cart-thumb" href={`/products/${item.slug}/`} data-field="product_link" aria-label={item.name}>
    <img src={item.image} alt={item.name} loading="lazy" data-field="image" />
    <span class="thumb-fallback" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7s6.5 6.4 6.5 11.3a6.5 6.5 0 0 1-13 0C5.5 9.1 12 2.7 12 2.7z"></path></svg>
    </span>
  </a>

  <div class="cart-copy">
    <a class="cart-product-link" href={`/products/${item.slug}/`} data-field="product_link">
      <h3 data-field="name">{item.name}</h3>
    </a>
    <p class="unit-price">單價 <span data-field="unit_price">{formatMoney(item.price)}</span></p>
  </div>

  <div class="cart-qty" aria-label="數量選擇">
    <button type="button" class="qty-btn" aria-label="減少數量" data-action="dec">−</button>
    <span data-field="quantity">{item.quantity}</span>
    <button type="button" class="qty-btn" aria-label="增加數量" data-action="inc">+</button>
  </div>

  <div class="cart-subtotal">
    <span class="sub-label">小計 </span><strong data-field="line_subtotal">{formatMoney(subtotal)}</strong>
  </div>

  <button class="remove" type="button" data-action="remove" aria-label="移除商品">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m2 0v12.5A1.5 1.5 0 0 1 15.5 21h-7A1.5 1.5 0 0 1 7 19.5V7M10 11v6M14 11v6"></path></svg>
  </button>
</article>

<style>
  .cart-row {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 164px 176px 38px;
    align-items: center;
    gap: 0;
    padding: 16px;
    border-bottom: 1px solid var(--divider);
  }
  .cart-row + .cart-row { border-top: 0; }

  .cart-product-link.cart-thumb {
    grid-column: 1;
    grid-row: 1;
  }

  .cart-thumb {
    position: relative;
    width: 104px;
    height: 104px;
    border-radius: var(--radius-md);
    background: var(--thumb-bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cart-thumb .thumb-fallback { display: flex; color: var(--text-faint); }
  .cart-thumb .thumb-fallback svg { width: 26px; height: 26px; }

  .cart-product-link {
    color: inherit;
    text-decoration: none;
  }

  .cart-copy {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding-left: 128px;
  }
  .cart-copy h3 { margin: 0; font-family: var(--font-zh-sans); font-size: 15px; font-weight: var(--title-weight); color: var(--text-primary); line-height: 1.45; }
  .cart-copy .unit-price {
    display: inline-flex;
    margin: 10px 0 0;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    background: var(--pill-bg);
    font-family: var(--font-zh-sans);
    font-size: 12px;
    color: var(--text-muted);
  }

  .cart-qty {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    gap: 6px;
    background: var(--color-surface);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 6px 10px;
  }
  .cart-qty .qty-btn {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--cta-dark);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }
  .cart-qty span { font-size: 14px; color: var(--text-primary); min-width: 20px; text-align: center; }

  .cart-subtotal { text-align: center; min-width: 0; }
  .cart-subtotal .sub-label { display: none; color: var(--text-muted); font-size: 13px; }
  .cart-subtotal strong { font-family: var(--font-serif); font-size: 20px; font-weight: var(--body-weight); color: var(--text-primary); white-space: nowrap; }

  .remove {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
  }
  .remove svg { width: 18px; height: 18px; }

  @media (max-width: 1100px) {
    .cart-row,
    :global(.cart-table-head) {
      grid-template-columns: minmax(220px, 1fr) 136px 144px 34px;
    }
    .cart-thumb { width: 92px; height: 92px; }
    .cart-copy { padding-left: 116px; }
    .cart-subtotal strong { font-size: 18px; }
  }

  /* mobile/mid: each line becomes a small card; qty + 小計 on a second row.
     481–768px 的四欄表格版會把標題欄壓到個位數 px（固定欄 314px + padding 恆佔），
     故卡片版斷點涵蓋到 768px。 */
  @media (max-width: 768px) {
    .cart-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px;
      padding: 12px;
      border: 1px solid var(--divider);
      border-radius: var(--radius-md);
      margin-bottom: 10px;
    }
    .cart-row + .cart-row { border-top: 1px solid var(--divider); }
    .cart-thumb { width: 60px; height: 60px; }
    .cart-copy { flex: 1 1 auto; padding-left: 0; }
    .cart-copy h3 { font-size: 14px; }
    .cart-copy .unit-price { margin-top: 4px; padding: 0; background: transparent; }
    .remove { order: 1; margin-left: auto; }
    .cart-qty { order: 2; padding: 3px 5px; }
    .cart-qty .qty-btn { width: 22px; height: 22px; }
    .cart-subtotal { order: 3; margin-left: auto; min-width: 0; }
    .cart-subtotal .sub-label { display: inline; }
    .cart-subtotal strong { font-size: 16px; }
  }
</style>
