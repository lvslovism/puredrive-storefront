---
/**
 * This shop's one-page home, laid out from design-mockups/01-home.png:
 *   hero → trust strip → catalogue → occasion cards → FAQ → LINE strip
 *
 * Shop-owned (README → Template boundary). It started from the template's
 * HomeLanding at 0c84048 and departs from it where the comp draws something
 * the template's version does not:
 *
 *   hero        a DARK photograph under white copy (the first in this family):
 *               a ruled label line between the lead and the button
 *               (`hero.tagline`), and letterspaced caps in the lower-right
 *               corner (`hero.corner`). The button goes to LINE.
 *   trust       hairlines between the columns.
 *   catalogue   cards set left on the pale card ground.
 *   occasions   the DARK ground (groundPolarity.scenes / sceneCard), a centred
 *               eyebrow, title and lead, and FOUR columns where the template
 *               has three, captions centred UNDER the photographs. Breakpoints:
 *               4 above 1024px, 2 from 1024px to 561px, 1 at 560px and below.
 *   FAQ         centred head; bordered rows numbered Q1：–Q5： by a CSS
 *               counter, so the question data stays unprefixed.
 *   LINE strip  eyebrow, title, one line and a white button, centred — no
 *               company details, no QR and no LINE mark.
 *
 * Data flow is the template's, unchanged: the catalogue comes from the API
 * (`?sort=featured`, detail pass for the variant range), and the FAQ's derived
 * answers come from merchant config.
 */
import Button from "../common/Button.astro";
import type { HomeLandingCopy } from "../../../brand/copy";
import { faq as faqCopy } from "../../../brand/copy";
import { formatMoney, identity } from "../../../brand/identity";
import { ground } from "../../lib/ground";
import { getProducts, getProduct, getMerchant } from "../../lib/commerce";
import { sizeAttrs } from "../../lib/image-size";
import { assertHeroCopy, heroAlign, heroCopyGround, heroMobileCopyGround, heroScrim } from "../../lib/hero-copy";
import { flags } from "../../lib/features";
import {
  derivePaymentFaqAnswer,
  deriveShippingFaqAnswer,
} from "../../lib/content-derivation.mjs";

interface Props {
  copy: HomeLandingCopy;
}

const { copy } = Astro.props;
const { hero, trust, catalogue, scenes, faq, lineCta } = copy;

// Fail-visible, because nothing type-checks this build: a hero missing `tone`
// used to render `home-hero--undefined` and stay green. See src/lib/hero-copy.ts.
assertHeroCopy(hero, "homeLanding");

/**
 * What sits between the hero copy and the photograph — TWICE, because there are
 * two photographs. `<picture>` swaps in the portrait crop on a phone, the copy
 * lands on different pixels of it, and the measurement can disagree.
 *
 * The tone's own answer is the desktop default — a scrim under a light image,
 * nothing under a dark one — and the phone inherits that unless a shop has
 * measured the portrait crop and set `mobileCopyGround`. Both classes are
 * always emitted; the stylesheet decides which one is live at which width.
 */
const copyGround = heroCopyGround(hero);
const mobileGround = heroMobileCopyGround(hero);
// Which side the copy sits on, and the shape of the wash under it. Both
// default to what the hard-coded rule used to do — see src/lib/hero-copy.ts.
const align = heroAlign(hero);
const scrim = heroScrim(hero);

/**
 * How many columns the assurance strip runs, DERIVED from the entry count.
 *
 * It was `repeat(5)` in the stylesheet, which is a second statement of a number
 * the array already makes — and the two duly disagreed: a shop with six
 * assurances hand-edited the 5 to a 6 in its own copy of this file, which is a
 * template edit made for a content reason and the exact drift `brand/` exists
 * to prevent. The footer counts its columns in frontmatter for the same reason
 * (CSS cannot see how many entries survived); this is that, one section up.
 *
 * Not a brand setting either. A shop that adds a sixth assurance has already
 * said "six" by writing six of them; asking it to say six again in a second
 * place is asking it to be wrong eventually.
 *
 * Up to six fill one desktop row. Beyond that a single row stops being
 * readable, so the strip splits into two balanced rows (7 → 4+3, 8 → 4+4)
 * rather than growing a seventh column. The two narrower steps cap rather than
 * fix the count, so a strip of two entries is not stretched to three on a
 * tablet: five reads 3+2 and six reads 3+3, both correct.
 */
const trustCount = trust.items.length;
const trustCols = Math.min(trustCount <= 6 ? trustCount : Math.ceil(trustCount / 2), 6);
const trustGrid = [
  `--trust-cols:${trustCols}`,
  `--trust-cols-md:${Math.min(3, trustCols)}`,
  `--trust-cols-sm:${Math.min(2, trustCols)}`,
].join(";");

// `?sort=featured`, matching HomeMultipage. It was a bare call, so the one-page
// preset was the only surface in the template taking the API's default order —
// a shop that had arranged its catalogue saw that arrangement on every page
// except its home page, which is the page the arrangement was for.
//
// It sorts rather than filters: measured against the live endpoint, the plain
// list and `?sort=featured` return the same products in a different order. So
// this changes the ORDER of the catalogue grid and nothing else.
const list = await getProducts("?sort=featured");
const details = await Promise.all(list.map((p) => getProduct(p.handle)));

const cards = details.map((product: any) => {
  const variants: any[] = product.variants?.length ? product.variants : [];
  // The DETAIL payload carries no min_price/max_price — only the LIST does — so
  // the card range is derived from the variants themselves. Reading
  // variants[0].price instead would be betting on the API returning them
  // cheapest-first, which nothing promises.
  const prices: number[] = variants
    .map((variant: any) => Number(variant.price))
    .filter((price: number) => Number.isFinite(price) && price > 0);
  const lowest = prices.length ? Math.min(...prices) : (product.min_price ?? 0);
  const highest = prices.length ? Math.max(...prices) : (product.max_price ?? 0);
  return {
    id: product.id,
    handle: product.handle,
    title: product.title,
    subtitle: product.subtitle ?? "",
    image: product.thumbnail,
    price: lowest,
    /** Non-zero only when the variants actually span a range. */
    priceTo: highest > lowest ? highest : 0,
  };
});

const merchant = await getMerchant();

// The payment and shipping answers are PROJECTED from the same merchant config
// checkout renders from — the questions live in brand/copy.ts, the answers to
// those two do not. A one-page shop absorbing /faq must not grow a second,
// drifting list on the way.
/**
 * Derived LAZILY — only a question that ASKS for one pays for it.
 *
 * Both answers used to be computed up front, and both throw by design when the
 * merchant declares nothing to derive from: a frozen payment list outliving the
 * real one is the failure they exist to prevent. That was safe for as long as
 * every storefront sold something. `flags.commerce` made a shop with no payment
 * methods and no shipping methods a legitimate configuration, and an eager
 * derive turned it into a build that cannot render its home page — over two
 * answers no question on the page had asked for.
 *
 * The fail-visible behaviour is unchanged where it means anything: an FAQ that
 * DOES carry `derive: 'payment'` on a merchant that SELLS and declares no
 * methods still throws.
 *
 * Lazy was not enough on its own, and four storefronts proved it. The shipped
 * `faq.items` ASKS both questions, so a showcase shop still threw unless it
 * edited the array — and the edit everyone reached for was emptying it, which
 * is also how the whole FAQ band is removed. So the same defect arrived four
 * times looking like four content decisions. A derive that cannot succeed on
 * this shop's shape now drops its own question instead.
 */
const DERIVE_ANSWER: Record<string, () => string | null> = {
  payment: () => derivePaymentFaqAnswer(merchant?.payment_config, { sells: flags.commerce }),
  shipping: () => deriveShippingFaqAnswer(merchant?.shipping_config, { sells: flags.commerce }),
};
const faqItems = faqCopy.items.flatMap((item) => {
  if (!item.derive) return [item];
  const derived = DERIVE_ANSWER[item.derive]?.();
  // An unrecognised `derive` key keeps the authored answer, as it always has.
  if (derived === undefined) return [item];
  if (derived === null) return [];
  return [{ ...item, answer: derived }];
});
// Config-driven, never hardcoded — same source the PDP and checkout read.
const freeShippingThreshold = merchant?.shipping_config?.free_shipping_threshold ?? null;
---

  <section
    class:list={[
      "home-hero",
      `home-hero--${hero.tone}`,
      /* The scrim, the panel, or the photograph plain — above 760px and below
         it, separately. 'none' is a claim that the copy area was MEASURED, and
         a phone is a different measurement: see brand/copy.ts → HeroCopy and
         docs/PITFALLS.md #7. */
      `home-hero--ground-${copyGround}`,
      `home-hero--mground-${mobileGround}`,
      /* Which side the copy sits on, and the wash that makes it legible there —
         four independent switches, see brand/copy.ts → HeroCopy.align/.scrim.

         A class appears only where it DEPARTS from the default, which is the
         same rule the ground switches above follow: present when it does
         something, absent when it does not. The defaults live in `.home-hero`
         itself, so a `home-hero--scrim-standard` would match no rule at all —
         and a class matching no rule is the precise shape of failure this
         component's contract exists to make loud. It also means a shop that
         has touched neither field emits the markup it emitted before either
         field existed. */
      align === "right" && "home-hero--align-right",
      scrim.from === "right" && "home-hero--scrim-from-right",
      scrim.tint === "dark" && "home-hero--scrim-dark",
      scrim.depth !== "standard" && `home-hero--scrim-${scrim.depth}`,
    ]}
    id="hero"
    data-section="hero"
  >
    {/* LCP element. The mobile source is listed first — <picture> takes the
        first source whose media matches, so the portrait crop must outrank the
        desktop image. fetchpriority="high" and no loading="lazy": this is the
        one image on the page that must start downloading immediately. */}
    <picture>
      <source media="(max-width: 720px)" srcset={hero.mobileImage} />
      <img
        src={hero.image}
        alt={hero.imageAlt}
        {...sizeAttrs(hero.image)}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="container hero-copy">
      {/* Empty renders nothing, the way identity.logoSubtext does: a comp with
          no line above the headline is a choice, and an empty <p> is a gap the
          reader has to account for. */}
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1>{hero.title}</h1>
      <p class="hero-body">{hero.description}</p>
      {hero.tagline && <p class="hero-tagline">{hero.tagline}</p>}
      {/^https?:/.test(hero.ctaHref) ? (
        <Button href={hero.ctaHref} target="_blank" rel="noopener noreferrer">{hero.ctaLabel}</Button>
      ) : (
        <Button href={hero.ctaHref}>{hero.ctaLabel}</Button>
      )}
    </div>
    {/* Letterspaced caps in the photograph's lower-right corner, wide screens
        only. Not part of the copy block, and MEASURED like it. */}
    {hero.corner && <p class="hero-corner" lang="en">{hero.corner}</p>}
  </section>

  {trust.items.length > 0 && (
    <section class="trust-strip" data-section="trust" {...ground("trust")}>
      <div class="container trust-list" style={trustGrid}>
        {trust.items.map((item, index) => (
          <article>
            {/* The marker is the entry's POSITION, not a picture of a number.
                It used to be `icon`, and a shop with no glyphs of its own
                pointed all five at the same placeholder — which draws a "1" —
                so the strip counted 1 1 1 1 1. Nothing was incrementing,
                because nothing was counting. A shop that HAS glyphs supplies
                `icon` and gets them instead, masked so they take the palette
                (pitfall #5). */}
            {item.icon ? (
              <span class="trust-glyph" style={`--glyph: url('${item.icon}')`} aria-hidden="true"></span>
            ) : (
              <span class="trust-num" aria-hidden="true">{index + 1}</span>
            )}
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {cards.length > 0 && (
    <section class="section catalogue" id="catalogue" data-section="catalogue" {...ground("catalogue")}>
      <div class="container">
        <div class="section-head">
          <div>
            {catalogue.eyebrow && <p class="eyebrow">{catalogue.eyebrow}</p>}
            <h2 class="section-title">{catalogue.title}</h2>
            <p class="lead">{catalogue.lead}</p>
          </div>
          {/* A one-page shop has nowhere to send anyone from here — this block
              already IS the whole catalogue — so the link is optional and its
              absence removes the anchor rather than emptying it. */}
          {catalogue.linkLabel && (
            <a class="section-head-link" href={catalogue.linkHref}>{catalogue.linkLabel}</a>
          )}
        </div>

        <div class="catalogue-grid">
          {cards.map((card) => (
            <a class="catalogue-card" href={`/products/${card.handle}`} aria-label={card.title} {...ground("catalogueCard")}>
              <span class="catalogue-media">
                {/* Product images are remote, so their intrinsic size can't be
                    read at build time. The attributes only have to carry the
                    right ratio; the CSS aspect-ratio below is authoritative. */}
                <img src={card.image} alt={card.title} width="800" height="800" loading="lazy" decoding="async" />
              </span>
              <span class="catalogue-body">
                <span class="catalogue-name">{card.title}</span>
                {card.subtitle && <span class="catalogue-subtitle">{card.subtitle}</span>}
                <span class="catalogue-price">
                  {card.priceTo
                    ? `${formatMoney(card.price)} – ${formatMoney(card.priceTo)}`
                    : formatMoney(card.price)}
                </span>
              </span>
            </a>
          ))}
        </div>

        {/* A promise about a checkout, so only a shop that HAS one makes it.
            Same rule as the product page's copy of this note. */}
        {flags.commerce && freeShippingThreshold && (
          <p class="catalogue-note">滿 {formatMoney(freeShippingThreshold)} 免運費</p>
        )}
      </div>
    </section>
  )}

  {scenes.items.length > 0 && (
    <section class="section scenes" id="scenes" data-section="scenes" {...ground("scenes")}>
      <div class="container">
        <div class="scenes-head">
          {scenes.eyebrow && <p class="scenes-eyebrow" lang="en">{scenes.eyebrow}</p>}
          <h2 class="section-title scenes-title">{scenes.title}</h2>
          {scenes.lead && <p class="scenes-lead">{scenes.lead}</p>}
        </div>
        {/* Four columns in this shop — see the breakpoints at the foot. */}
        <div class="scene-grid">
          {scenes.items.map((item) => (
            <article class="scene-card" {...ground("sceneCard")}>
              <img src={item.image} alt={item.imageAlt ?? item.title} {...sizeAttrs(item.image)} loading="lazy" decoding="async" />
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {faqItems.length > 0 && (
    <section class="section faq-block" id="faq" data-section="faq">
      <div class="container faq-grid">
        <div class="faq-head">
          {faq.eyebrow && <p class="eyebrow">{faq.eyebrow}</p>}
          <h2 class="section-title">{faq.title}</h2>
          {faq.lead && <p class="lead">{faq.lead}</p>}
        </div>
        {/* <details> disclosure: open/close is the browser's, so every answer is
            readable before — and without — JavaScript, and all of them are in
            the HTML for a crawler either way. All closed, as drawn; the Q1：
            prefixes are the counter in the stylesheet. */}
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* The LINE strip: the olive band above the footer. `id="contact"` is the
      anchor src/lib/line.ts falls back to and the footer's 聯絡我們 link
      targets, so it stays whatever this block looks like.

      No company details and no QR: the footer directly below carries the
      details, and the comp draws them there, once. */}
  <section class="line-strip" id="contact" data-section="line_cta">
    <div class="container line-grid">
      <div class="line-copy">
        {lineCta.eyebrow && <p class="line-eyebrow" lang="en">{lineCta.eyebrow}</p>}
        <h2>{lineCta.title.replace("{channel}", identity.line.id)}</h2>
        {lineCta.lines.map((line) => <p>{line}</p>)}
      </div>
      <a class="line-btn" href={identity.line.addFriendUrl} target="_blank" rel="noopener noreferrer">
        <span>{lineCta.buttonLabel}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14.5M13 6.2 19.2 12 13 17.8"></path></svg>
      </a>
    </div>
  </section>


<style>
  /* Laid out from design-mockups/01-home.png. Every colour is a var(--…) whose
     value is sampled from that comp and declared once in brand/identity.ts —
     `npm run audit:color` fails the build on a literal. */

  .home-hero {
    position: relative;
    min-height: min(720px, 100vh);
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--color-soft);
  }

  .home-hero picture,
  .home-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero img {
    object-fit: cover;
    object-position: center;
  }

  /* --- Which ground is live -------------------------------------------------
     The three grounds are written ONCE, below, and read two switches. These
     rules set the switches, and they are the only place the breakpoint appears:
     above 760px the desktop answer decides, at 760px and below the phone's
     does. Nothing has to be undone at the breakpoint, because each media block
     only ever sets its own.

     A switch is `block` when that ground is live and ABSENT when it is not, so
     the rules below can read it as `var(--hero-scrim, none)` — which is exactly
     what `display` wants, and means `--ground-none` needs no rule of its own.

     The panel carries its inks in the same rule as its switch, deliberately: a
     panel without reversed-out copy is a dark slab over dark text, so the two
     must not be separately settable.

     THE EYEBROW READS --color-on-dark-muted, and it used to read
     --color-footer-text. Same job, same ground, same floor — but the footer ink
     was standing in for a muted reversed ink because for a long time the
     palette declared no other. That stand-in made `footer-text` an ink on TWO
     grounds at once: this near-black wash, and the footer's own background. A
     shop wanting a PALE footer then needed one value light enough to clear AA
     here and dark enough to clear it there, and there is no such value —
     sweeping all 256 greys on a real palette, the count satisfying both is
     zero. Pointing these rules at the ink the palette declares for exactly this
     job frees the footer to be any colour it likes. Nothing left the audit:
     `on-dark-muted` was already an ink on the dark ground. */
  @media (min-width: 761px) {
    .home-hero--ground-scrim { --hero-scrim: block; }

    /* A DARK scrim is a dark ground, so it owes the copy the same reversed inks
       the panel owes it. The panel carries its inks beside its switch because a
       ground without them is a dark slab under dark text; a dark wash is that
       same bargain with a softer edge, and leaving it out shipped a hero whose
       eyebrow sat at 4.00:1 over its own ground — measured, not reasoned.
       Scoped to the scrim being LIVE at this width: the tint class is set
       whatever the ground, and reversing ink under no wash would be worse than
       the bug it fixes. */
    .home-hero--ground-scrim.home-hero--scrim-dark {
      --hero-ink: var(--color-on-dark);
      --hero-eyebrow-ink: var(--color-on-dark-muted);
      --hero-button-edge: var(--color-on-dark);
    }

    .home-hero--ground-panel {
      --hero-panel: block;
      --hero-ink: var(--color-on-dark);
      --hero-eyebrow-ink: var(--color-on-dark-muted);
      --hero-button-edge: var(--color-on-dark);
    }
  }

  @media (max-width: 760px) {
    .home-hero--mground-scrim { --hero-scrim: block; }

    /* A DARK scrim is a dark ground, so it owes the copy the same reversed inks
       the panel owes it. The panel carries its inks beside its switch because a
       ground without them is a dark slab under dark text; a dark wash is that
       same bargain with a softer edge, and leaving it out shipped a hero whose
       eyebrow sat at 4.00:1 over its own ground — measured, not reasoned.
       Scoped to the scrim being LIVE at this width: the tint class is set
       whatever the ground, and reversing ink under no wash would be worse than
       the bug it fixes. */
    .home-hero--mground-scrim.home-hero--scrim-dark {
      --hero-ink: var(--color-on-dark);
      --hero-eyebrow-ink: var(--color-on-dark-muted);
      --hero-button-edge: var(--color-on-dark);
    }

    .home-hero--mground-panel {
      --hero-panel: block;
      --hero-ink: var(--color-on-dark);
      --hero-eyebrow-ink: var(--color-on-dark-muted);
      --hero-button-edge: var(--color-on-dark);
    }
  }

  /* Legibility scrim — the cheapest of the three grounds, and what a pale hero
     gets unless brand/copy.ts says otherwise. A dark photograph gets light copy
     instead (below) and no wash at all: a picture chosen for its dark side does
     not need rescuing, and washing it would flatten the thing that made it worth
     choosing. Built from a token plus `transparent`, so no colour literal
     enters src/.

     `none` is the third answer and has no rule anywhere: it is a shop saying it
     MEASURED the copy area and the photograph carries it. The wash is solid
     --color-surface for its first 26%, which on some crops reads less like a
     wash and more like the picture being missing from that quarter of the
     frame, so "keep the photograph" has to be sayable. */
  /* The wash is assembled from four switches rather than written out, so the
     eight useful combinations do not need eight rules. Each switch sets one
     custom property and the single gradient below reads all of them.

     The defaults ARE the old hard-coded rule: 100deg, --color-surface, solid
     to 26%, gone by 68%. A hero that declares no scrim fields resolves to that
     gradient to the percentage point. */
  .home-hero {
    --scrim-angle: 100deg;
    --scrim-tint: var(--color-surface);
    /* The colour the wash actually paints. Kept separate from --scrim-tint so
       the opaque depths pass the token STRAIGHT through: routing an opaque
       colour through color-mix() is a no-op that still re-serialises it into
       another colour space, which would have changed the computed value on
       every existing hero to say the same white a different way. */
    --scrim-color: var(--scrim-tint);
    --scrim-solid: 26%;
    --scrim-end: 68%;
  }

  /* 100deg and 260deg are mirror images about the vertical, so the wash enters
     from the opposite side at the same rake. */
  .home-hero--scrim-from-right { --scrim-angle: 260deg; }

  /* The panel's near-black, for a photograph that wants its copy reversed out
     rather than darkened onto. Same token the copy panel uses, so a shop that
     chooses both gets one colour rather than two that nearly match. */
  .home-hero--scrim-dark { --scrim-tint: var(--cta-dark); }

  /* Depth is where the wash starts letting the picture through and where it
     finishes. 'light' never goes fully opaque — it is a veil over a photograph
     that nearly carries the copy already. */
  .home-hero--scrim-light {
    --scrim-solid: 0%;
    --scrim-end: 55%;
    /* The one depth that is translucent. color-mix keeps the alpha out of the
       token, so brand/ never declares a see-through twin of a colour it
       already has, and audit:color still finds no literal in src/. */
    --scrim-color: color-mix(in srgb, var(--scrim-tint) 62%, transparent);
  }

  .home-hero--scrim-heavy {
    --scrim-solid: 42%;
    --scrim-end: 82%;
  }

  .home-hero::after {
    display: var(--hero-scrim, none);
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      var(--scrim-angle),
      var(--scrim-color) 0%,
      var(--scrim-color) var(--scrim-solid),
      transparent var(--scrim-end)
    );
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy > * {
    max-width: 520px;
  }

  /* --- Which side the copy sits on (hero.align) ---------------------------
     .hero-copy is also .container, which owns the page gutter and centres
     itself, so the copy cannot be moved by moving the block — that would take
     the gutter with it and leave the hero starting somewhere no other section
     does. What moves is the 520px measure INSIDE the container: pushed to the
     far edge with an auto margin, and its text set to the same side.

     The panel follows. It is drawn from the copy's leading edge outwards, so
     on a right-aligned hero it has to grow from the right or it would sit
     under the empty half of the block. */
  .home-hero--align-right .hero-copy > * {
    margin-left: auto;
    text-align: right;
  }

  /* THE BUTTON NEEDED ITS OWN LINE, and the reason is easy to read past.
     `margin-left: auto` moves a BLOCK-level box. `.button` is `display:
     inline-flex`, and an auto margin on an inline-level box computes to zero —
     so every other child of .hero-copy moved to the right edge and the button
     stayed exactly where it was, at the far left of the hero, under
     right-aligned copy. The `text-align: right` above did not save it either:
     that rule sets alignment INSIDE each child, and what positions an
     inline-level box is its PARENT's text-align, which .hero-copy itself never
     sets.

     Setting it on .hero-copy is the one-line fix and it is also the smallest:
     the children already declare their own alignment, so nothing else changes. */
  .home-hero--align-right .hero-copy {
    text-align: right;
  }

  .home-hero--align-right .hero-copy::before {
    left: auto;
    right: calc(-1 * var(--panel-pad));
  }

  /* --- Hero copy panel (copyGround / mobileCopyGround: "panel") -----------
     A ground of the shop's own under the hero copy, for the hero image that
     cannot carry the copy on its own.

     WHY IT IS A PSEUDO-ELEMENT and not a background on .hero-copy: .hero-copy
     also carries .container, which owns the page gutter and centres itself.
     Give it a width and the copy leaves the left edge every other block on the
     page starts from, and the panel centres itself in the middle of the hero.
     So the panel is drawn BEHIND, sized to the copy measure (520px — the same
     cap .hero-copy > * uses) plus its own padding, and the layout is untouched.

     `z-index: -1` puts it under the copy without leaving .hero-copy's stacking
     context, so it stays above the photograph. */
  .hero-copy {
    --panel-pad: clamp(24px, 3vw, 44px);
  }

  .hero-copy::before {
    display: var(--hero-panel, none);
    content: "";
    position: absolute;
    z-index: -1;
    inset-block: calc(-1 * var(--panel-pad));
    left: calc(-1 * var(--panel-pad));
    width: calc(520px + var(--panel-pad) * 2);
    max-width: calc(100% + var(--panel-pad) * 2);
    background: var(--cta-dark);
