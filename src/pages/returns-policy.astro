---
/**
 * 退換貨政策 — a standard route, not an optional one.
 *
 * A route of its own rather than a clause inside /terms: Taiwan's 消費者保護法
 * gives a七日鑑賞期 to every distance sale, so every shop built on this template
 * needs the page — and it wants a flow diagram and condition panels that the
 * clause layout in LegalDocument cannot carry.
 *
 * The contact block derives from the merchant record — same source as the
 * footer, /contact and the other two legal pages — so the four cannot disagree
 * about a phone number.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { legal } from "../../brand/legal";
import { identity } from "../../brand/identity";
import { getMerchant } from "../lib/commerce";
import { deriveLegalContact } from "../lib/content-derivation.mjs";
import { SITE_ORIGIN } from "../lib/commerce";

const merchant = await getMerchant();
const company = deriveLegalContact(merchant?.storefront_config);
const returns = legal.returns;
const { hero, inspection, steps, panels, contact } = returns;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: `${SITE_ORIGIN}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: returns.metaTitle,
      item: `${SITE_ORIGIN}/returns-policy`,
    },
  ],
};
---

<BaseLayout
  title={returns.metaTitle}
  description={returns.metaDescription}
  jsonLd={breadcrumbJsonLd}
>
  <section class="returns-page section" data-section="returns_policy">
    <div class="container returns-shell">
      <p class="legal-crumb">首頁 / {returns.metaTitle}</p>
      <header class="returns-header">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="page-title">{hero.title}</h1>
        <p class="lead">{hero.lead}</p>
        <p class="returns-updated">最後更新：{returns.effectiveDate}</p>
      </header>

      <section class="returns-block" data-section="returns_inspection">
        <h2>{inspection.title}</h2>
        <p class="lead">{inspection.lead}</p>
        <ul class="check-list">
          {inspection.points.map((point) => <li>{point}</li>)}
        </ul>
      </section>

      <section class="returns-block" data-section="returns_steps">
        <h2>{steps.title}</h2>
        <ol class="step-row">
          {steps.items.map((item) => (
            <li>
              {item.icon && <img src={item.icon} alt="" width="34" height="34" loading="lazy" decoding="async" />}
              <p class="step-label">{item.step}. {item.title}</p>
              <p class="step-text">{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <div class="panel-grid">
        {panels.map((panel) => (
          <section class="returns-panel">
            <h3>{panel.title}</h3>
            <ul>{panel.items.map((line) => <li>{line}</li>)}</ul>
          </section>
        ))}
      </div>

      <section class="returns-contact" data-section="returns_contact">
        <h2>{contact.title}</h2>
        <p class="lead">{contact.lead}</p>
        <dl>
          <div><dt>LINE 官方客服</dt><dd>{identity.line.id}</dd></div>
          <div><dt>客服信箱</dt><dd>{identity.contact.email}</dd></div>
          <div><dt>客服專線</dt><dd>{company.phone}</dd></div>
          <div><dt>服務時間</dt><dd>{company.serviceHours}</dd></div>
        </dl>
      </section>

      <p class="returns-note">{returns.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .returns-page {
    background: var(--color-soft);
  }

  .returns-shell {
    display: grid;
    gap: var(--space-6);
    max-width: 960px;
  }

  .legal-crumb {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--meta-text-size);
    letter-spacing: var(--meta-letter-spacing);
  }

  .returns-header {
    display: grid;
    gap: var(--space-2);
  }

  .returns-header .lead {
    margin: 0;
  }

  .returns-updated {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: var(--meta-text-size);
  }

  .returns-block,
  .returns-panel,
  .returns-contact {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .returns-block h2,
  .returns-contact h2 {
    margin: 0 0 var(--space-3);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--card-title-size);
    font-weight: var(--title-weight);
    letter-spacing: 0.06em;
    line-height: var(--card-title-line-height);
  }

  .returns-block .lead,
  .returns-contact .lead {
    margin: 0 0 var(--space-4);
  }

  .check-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .check-list li,
  .returns-panel li {
    position: relative;
    padding-left: 1.4em;
    color: var(--text-secondary);
    font-size: var(--description-text-size);
    line-height: var(--description-line-height);
  }

  .check-list li::before,
  .returns-panel li::before {
    content: "・";
    position: absolute;
    left: 0;
    color: var(--color-cta);
  }

  .step-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step-row li {
    min-width: 0;
    text-align: center;
  }

  .step-row img {
    width: 34px;
    height: 34px;
    margin: 0 auto var(--space-2);
    object-fit: contain;
  }

  .step-label {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--description-text-size);
    line-height: 1.5;
  }

  .step-text {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: var(--meta-text-size);
    line-height: 1.6;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .returns-panel h3 {
    margin: 0 0 var(--space-3);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--card-title-size);
    font-weight: var(--title-weight);
    line-height: var(--card-title-line-height);
  }

  .returns-panel ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .returns-contact dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .returns-contact dt {
    color: var(--text-muted);
    font-size: var(--meta-text-size);
    line-height: 1.6;
  }

  .returns-contact dd {
    margin: 2px 0 0;
    color: var(--text-secondary);
    font-size: var(--description-text-size);
    line-height: 1.6;
  }

  .returns-note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--meta-text-size);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .step-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .step-row,
    .panel-grid,
    .returns-contact dl {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
