---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/product/ProductGrid.astro";
import { products as productsCopy } from "../../../brand/copy";
import { getProducts, toCard } from "../../lib/commerce";
import { buildProductsItemList } from "../../lib/seo";

const products = (await getProducts()).map(toCard);
const itemListJsonLd = buildProductsItemList(products);
const { hero } = productsCopy;
---

<BaseLayout
  title={productsCopy.metaTitle}
  description={productsCopy.metaDescription}
  jsonLd={itemListJsonLd}
>
  <section class="products-hero page-hero" data-section="products_hero">
    <div class="container hero-copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="page-title">{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
    </div>
  </section>

  <section class="section product-list-section" data-section="product_grid">
    <div class="container">
      <div class="toolbar">
        <p>共 {products.length} 件商品</p>
      </div>
      <ProductGrid products={products} desktopColumns={3} tabletColumns={2} mobileColumns={1} />
    </div>
  </section>
</BaseLayout>

<style>
  .products-hero {
    background: var(--color-soft);
  }

  .product-list-section {
    padding-top: clamp(40px, 3.2vw, 56px);
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .toolbar p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--footer-copy-size);
  }
</style>
