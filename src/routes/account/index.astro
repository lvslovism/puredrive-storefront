---
/**
 * Member area.
 *
 * One page, four sections, a sidebar that jumps between them: 會員總覽,
 * 個人資料, 我的訂單, 收貨地址. The comp also draws a gold-tier card, a points
 * balance, a coupon shelf and a wishlist — none of them are built. The wallet
 * exists on the back end but nothing in this storefront writes to or reads it
 * yet, and a points figure that is not the member's real balance is worse than
 * no points figure at all.
 *
 * 個人資料 is READ-ONLY. `PATCH /me` accepts display_name, the name parts and a
 * birth date — but not the e-mail or the phone, which are exactly the two a
 * member comes here to correct. An 編輯 button that silently cannot touch them
 * promises more than the API gives.
 *
 * 收貨地址 is the real thing: `/v1/storefront/me/addresses` has list, create,
 * update and delete, so the card does all four.
 *
 * NB: order rows and address cards are built in account.ts at runtime, so their
 * styles are GLOBAL (Astro-scoped styles don't attach to JS-created elements)
 * and are namespaced under .member-page instead.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { member } from "../../../brand/copy";
import { flags } from "../../lib/features";
---

<BaseLayout title="會員中心" description={member.accountMetaDescription}>
  <section class="member-hero" data-section="member_hero">
    <div class="container">
      <h1>{member.accountHero.title}</h1>
      <p>{member.accountHero.lead}</p>
      <nav class="crumb" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{member.accountHero.title}</span>
      </nav>
    </div>
  </section>

  <section class="section member-page" data-account-page>
    <div class="container">
      <p class="state-msg" data-account-loading>會員資料載入中…</p>
      <p class="state-msg err" data-account-error style="display:none"></p>

      <div class="member-grid" data-account-content style="display:none">
        <!-- ── LEFT: identity + section nav ───────────────────────────── -->
        <aside class="card side">
          <div class="side-profile">
            <div class="side-avatar" data-m-avatar aria-hidden="true"></div>
            <p class="side-hello">您好，<span data-m-name>會員</span></p>
            <p class="side-join" data-m-join></p>
          </div>
          <nav class="side-nav">
            <a class="side-item is-active" href="#overview" data-side-link="overview">
              <span class="side-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.4 12 4l8 6.4V19a1 1 0 0 1-1 1h-4v-5.4H9V20H5a1 1 0 0 1-1-1z"></path></svg></span>
              會員總覽
            </a>
            <a class="side-item" href="#profile" data-side-link="profile">
              <span class="side-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="3.2"></circle><path d="M5.5 19c1.2-3 3.7-4.6 6.5-4.6S17.3 16 18.5 19"></path></svg></span>
              個人資料
            </a>
            <a class="side-item" href="#orders" data-side-link="orders">
              <span class="side-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.4" y="5.4" width="17.2" height="13.2" rx="2"></rect><path d="M3.4 9.4h17.2"></path></svg></span>
              我的訂單
            </a>
            <a class="side-item" href="#addresses" data-side-link="addresses">
              <span class="side-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"></path><circle cx="12" cy="10" r="2.6"></circle></svg></span>
              收貨地址
            </a>
            <button type="button" class="side-item side-logout" data-logout>
              <span class="side-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"></path><path d="M10 12H3M6 8l-4 4 4 4"></path></svg></span>
              登出
            </button>
          </nav>
        </aside>

        <!-- ── RIGHT: the sections ────────────────────────────────────── -->
        <div class="member-body">
          <section class="card welcome" id="overview">
            <h2 data-m-greeting>—</h2>
            <p>{member.accountWelcome.lead}</p>
          </section>

          <section class="card" id="orders">
            <div class="card-head">
              <h2>我的訂單</h2>
              <span class="card-note" data-orders-count></span>
            </div>

            <div class="filters" data-order-filters>
              <button type="button" class="pill is-active" data-filter="all">全部</button>
              <button type="button" class="pill" data-filter="pending_payment">待付款</button>
              <button type="button" class="pill" data-filter="to_ship">待出貨</button>
              <button type="button" class="pill" data-filter="done">已完成</button>
            </div>

            <div class="o-table" role="table" aria-label="我的訂單">
              <div class="o-head" role="row">
                <span role="columnheader">訂單編號</span>
                <span role="columnheader">訂購日期</span>
                <span role="columnheader">訂單金額</span>
                <span role="columnheader">訂單狀態</span>
                <span role="columnheader">操作</span>
              </div>
              <div class="o-body" data-order-list></div>
            </div>

            <p class="empty-msg" data-orders-empty style="display:none">目前還沒有訂單</p>
          </section>

          <div class="pair">
            <section class="card" id="profile">
              <div class="card-head">
                <h2>個人資料</h2>
              </div>
              {/* Read-only by design — see the note at the top of this file. */}
              <dl class="kv">
                <div><dt>會員姓名</dt><dd data-p-name>—</dd></div>
                <div><dt>電子郵件</dt><dd data-p-email>—</dd></div>
                <div><dt>手機號碼</dt><dd data-p-phone>—</dd></div>
                <div data-p-birth-row style="display:none"><dt>生日</dt><dd data-p-birth>—</dd></div>
                <div><dt>加入日期</dt><dd data-p-joined>—</dd></div>
              </dl>
            </section>

            <section class="card" id="addresses">
              <div class="card-head">
                <h2>收貨地址</h2>
                <button type="button" class="ghost-btn" data-addr-new>新增地址</button>
              </div>

              <p class="empty-msg" data-addr-empty style="display:none">尚未建立收貨地址</p>
              <p class="empty-msg err" data-addr-error style="display:none"></p>
              <div class="addr-list" data-addr-list></div>

              <!-- The one form, reused for create and edit; [data-addr-id] holds
                   the row being edited and is empty for a new one. -->
              <form class="addr-form" data-addr-form style="display:none">
                <input type="hidden" data-addr-id value="" />
                <div class="addr-fields">
                  <label><span>地址名稱</span><input type="text" data-af-label placeholder="例：住家" maxlength="20" /></label>
                  <label><span>收件人 *</span><input type="text" data-af-recipient placeholder="收件人姓名" maxlength="50" required /></label>
                  <label><span>手機 *</span><input type="tel" data-af-phone placeholder="09XXXXXXXX" required /></label>
                  <label><span>郵遞區號</span><input type="text" data-af-zip inputmode="numeric" placeholder="例：106" maxlength="10" /></label>
                  <label><span>縣市</span><input type="text" data-af-city placeholder="例：臺北市" maxlength="20" /></label>
                  <label><span>鄉鎮市區</span><input type="text" data-af-district placeholder="例：大安區" maxlength="20" /></label>
                  <label class="full"><span>地址 *</span><input type="text" data-af-address placeholder="路名、巷弄、門牌號碼" maxlength="200" required /></label>
                </div>
                <label class="check"><input type="checkbox" data-af-default /><span>設為預設地址</span></label>
                <p class="form-err" data-af-error style="display:none"></p>
                <div class="form-actions">
                  <button type="submit" class="primary-btn" data-af-save>儲存</button>
                  <button type="button" class="ghost-btn" data-af-cancel>取消</button>
                </div>
              </form>
            </section>
          </div>

          {/* 邀請好友. Two gates, both needed: the affiliate FLAG decides whether
              the card is built into the page at all (it is also what decides whether
              /r/<code> exists to link to), and account.ts keeps the built card hidden
              until /me/referral confirms the merchant has the programme enabled. */}
          {flags.affiliate && (
            <section class="card referral-card" data-referral-card style="display:none">
              <div class="card-head">
                <h2>邀請好友</h2>
                <span class="card-note" data-ref-sub></span>
              </div>
              <div class="referral-code-row">
                <div class="referral-code-box">
                  <span class="referral-code-label">我的推薦碼</span>
                  <span class="referral-code" data-ref-code></span>
                </div>
                <div class="referral-actions">
                  <button type="button" class="referral-btn" data-ref-copy>複製連結</button>
                  <a class="referral-btn referral-btn-line" data-ref-line target="_blank" rel="noopener">LINE 分享</a>
                </div>
              </div>
              <div class="referral-stats">
                <div class="referral-stat"><span class="k">成功邀請</span><span class="v" data-ref-orders>0</span></div>
                <div class="referral-stat"><span class="k">已獲點數</span><span class="v" data-ref-earned>0</span></div>
                <div class="referral-stat"><span class="k">待入帳</span><span class="v" data-ref-pending>0</span></div>
              </div>
            </section>
          )}
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initAccountPage } from "../../scripts/account";
    initAccountPage();
  </script>
</BaseLayout>

<style is:global>
  .member-hero { background: var(--cta-dark); color: var(--color-on-dark); padding-block: clamp(40px, 6vw, 72px); }
  .member-hero h1 { margin: 0; font-family: var(--font-serif); font-size: var(--page-title-size); font-weight: var(--title-weight); letter-spacing: 0.16em; line-height: 1.2; }
  .member-hero p { margin: 10px 0 0; color: var(--color-cta); font-size: var(--description-text-size); letter-spacing: 0.1em; }
  .member-hero .crumb { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-4); font-size: var(--meta-text-size); opacity: 0.8; }
  .member-hero .crumb a { color: inherit; }

  .member-page { background: var(--color-soft); }
  .member-page .state-msg { text-align: center; padding: 60px 16px; color: var(--text-secondary); }
  .member-page .state-msg.err { color: var(--color-danger); }

  .member-page .member-grid { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: var(--space-5); align-items: start; }
  .member-page .member-body { display: grid; gap: var(--space-4); min-width: 0; }
  .member-page .card { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); padding: 24px; }
  .member-page .card-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; }
  .member-page .card-head h2 { margin: 0; color: var(--color-ink); font-family: var(--font-serif); font-size: var(--card-title-size); font-weight: var(--title-weight); letter-spacing: var(--card-title-letter-spacing); }
  .member-page .card-note { color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .empty-msg { margin: 0; padding: 22px 0; text-align: center; color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .empty-msg.err { color: var(--color-danger); }

  /* ── sidebar ───────────────────────────────────────────────────────── */
  .member-page .side { position: sticky; top: 96px; padding: 24px 18px; }
  .member-page .side-profile { display: grid; justify-items: center; gap: 6px; padding-bottom: 20px; margin-bottom: 16px; border-bottom: 1px solid var(--color-border); text-align: center; }
  .member-page .side-avatar { width: 56px; height: 56px; border-radius: 50%; overflow: hidden; background: var(--color-mist); color: var(--color-cta); border: 1px solid var(--color-cta); display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 22px; line-height: 1; }
  .member-page .side-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .member-page .side-hello { margin: 8px 0 0; color: var(--color-ink); font-size: var(--description-text-size); }
  .member-page .side-join { margin: 0; color: var(--text-muted); font-size: var(--meta-text-size); }

  .member-page .side-nav { display: grid; gap: 2px; }
  .member-page .side-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; border: 0; border-radius: var(--radius-xs); background: transparent; color: var(--text-secondary); font: inherit; font-size: var(--description-text-size); text-align: left; cursor: pointer; }
  .member-page .side-item:hover { background: var(--color-soft); color: var(--color-ink); }
  .member-page .side-item.is-active { background: var(--color-cta); color: var(--color-cta-text); }
  .member-page .side-ic svg { display: block; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .member-page .side-logout:disabled { opacity: 0.6; cursor: progress; }

  .member-page .welcome h2 { margin: 0 0 8px; color: var(--color-ink); font-family: var(--font-serif); font-size: var(--card-title-size); font-weight: var(--title-weight); }
  .member-page .welcome p { margin: 0; color: var(--text-secondary); font-size: var(--description-text-size); line-height: 1.8; }

  /* ── orders ────────────────────────────────────────────────────────── */
  .member-page .filters { display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; scrollbar-width: none; }
  .member-page .filters::-webkit-scrollbar { display: none; }
  .member-page .pill { flex: none; border: 1px solid var(--color-border); border-radius: 999px; padding: 6px 16px; background: transparent; color: var(--text-secondary); font: inherit; font-size: var(--meta-text-size); cursor: pointer; white-space: nowrap; }
  .member-page .pill:hover { border-color: var(--color-cta); color: var(--color-ink); }
  .member-page .pill.is-active { border-color: var(--color-cta); background: var(--color-cta); color: var(--color-cta-text); }

  .member-page .o-table { border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; }
  .member-page .o-head,
  .member-page .o-main { display: grid; grid-template-columns: minmax(0, 1.35fr) 1fr 1fr 1fr auto; gap: 12px; align-items: center; padding: 13px 16px; }
  .member-page .o-head { background: var(--color-soft); border-bottom: 1px solid var(--color-border); color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .o-row { border-bottom: 1px solid var(--color-border); }
  .member-page .o-row:last-child { border-bottom: 0; }
  .member-page .o-num { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: var(--meta-text-size); color: var(--color-ink); overflow: hidden; text-overflow: ellipsis; }
  .member-page .o-date, .member-page .o-amt { color: var(--text-secondary); font-size: var(--meta-text-size); }
  .member-page .o-amt { color: var(--color-ink); }
  .member-page .o-status { justify-self: start; padding: 3px 10px; border-radius: 999px; background: var(--color-mist); color: var(--color-cta); font-size: var(--meta-text-size); white-space: nowrap; }
  .member-page .o-toggle { justify-self: end; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: transparent; padding: 6px 14px; color: var(--text-secondary); font: inherit; font-size: var(--meta-text-size); cursor: pointer; white-space: nowrap; }
  .member-page .o-toggle:hover { border-color: var(--color-cta); color: var(--color-ink); }
  .member-page .o-detail { padding: 4px 16px 18px; display: grid; gap: 12px; background: var(--color-soft); }

  .member-page .detail-loading, .member-page .detail-error { margin: 0; padding: 8px 0; font-size: var(--meta-text-size); color: var(--text-secondary); }
  .member-page .detail-error { color: var(--color-danger); }
  .member-page .detail-items { display: grid; gap: 8px; }
  .member-page .detail-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; font-size: var(--meta-text-size); }
  .member-page .detail-row .k { color: var(--text-secondary); min-width: 0; }
  .member-page .detail-row .v { color: var(--color-ink); white-space: nowrap; flex: none; }
  .member-page .detail-sep { height: 1px; background: var(--color-border); }
  .member-page .detail-grand { display: flex; align-items: baseline; justify-content: space-between; }
  .member-page .detail-grand .k { font-size: var(--meta-text-size); color: var(--text-secondary); }
  .member-page .detail-grand .v { font-family: var(--font-serif); font-size: var(--card-title-size); color: var(--color-cta); }
  .member-page .detail-meta { display: grid; gap: 4px; font-size: var(--meta-text-size); color: var(--text-muted); }
  .member-page .detail-payinfo { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--color-cta); border-radius: var(--radius-xs); }
  .member-page .detail-payinfo .payinfo-title { font-family: var(--font-serif); font-size: var(--description-text-size); color: var(--color-ink); }
  .member-page .detail-payinfo .detail-row .v { font-family: var(--font-serif); letter-spacing: 0.04em; }
  .member-page .detail-payinfo .payinfo-hold { font-size: var(--meta-text-size); color: var(--text-secondary); line-height: 1.6; }

  /* ── profile + addresses ───────────────────────────────────────────── */
  .member-page .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); align-items: start; }
  .member-page .kv { display: grid; gap: 12px; margin: 0; }
  .member-page .kv > div { display: grid; grid-template-columns: 6em minmax(0, 1fr); gap: 12px; }
  .member-page .kv dt { color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .kv dd { margin: 0; color: var(--color-ink); font-size: var(--meta-text-size); word-break: break-word; }

  .member-page .addr-list { display: grid; gap: 12px; }
  .member-page .addr-card { display: grid; gap: 6px; padding: 14px; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: var(--color-soft); }
  .member-page .addr-top { display: flex; align-items: center; gap: 8px; }
  .member-page .addr-label { color: var(--color-ink); font-size: var(--description-text-size); }
  .member-page .addr-default { padding: 2px 8px; border-radius: 999px; background: var(--color-mist); color: var(--color-cta); font-size: var(--meta-text-size); }
  .member-page .addr-tools { margin-left: auto; display: inline-flex; gap: 6px; }
  .member-page .addr-tool { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: transparent; color: var(--text-muted); cursor: pointer; }
  .member-page .addr-tool:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .member-page .addr-tool svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .member-page .addr-line { margin: 0; color: var(--text-secondary); font-size: var(--meta-text-size); line-height: 1.6; }

  .member-page .addr-form { display: grid; gap: 14px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-border); }
  .member-page .addr-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .member-page .addr-form label { display: grid; gap: 6px; }
  .member-page .addr-form label > span { color: var(--text-secondary); font-size: var(--meta-text-size); }
  .member-page .addr-form .full { grid-column: 1 / -1; }
  .member-page .addr-form input[type="text"], .member-page .addr-form input[type="tel"] { width: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: 10px 12px; background: var(--color-surface); color: var(--color-ink); font: inherit; font-size: var(--meta-text-size); }
  .member-page .addr-form .check { display: flex; flex-direction: row; align-items: center; gap: 8px; }
  .member-page .addr-form .check input { width: auto; }
  .member-page .form-err { margin: 0; color: var(--color-danger); font-size: var(--meta-text-size); }
  .member-page .form-actions { display: flex; gap: 10px; }

  .member-page .primary-btn { min-height: 40px; padding: 10px 22px; border: 0; border-radius: var(--radius-xs); background: var(--color-cta); color: var(--color-cta-text); font: inherit; font-size: var(--meta-text-size); cursor: pointer; }
  .member-page .primary-btn:disabled { opacity: 0.6; cursor: progress; }
  .member-page .ghost-btn { min-height: 36px; padding: 8px 18px; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: transparent; color: var(--color-ink); font: inherit; font-size: var(--meta-text-size); cursor: pointer; }
  .member-page .ghost-btn:hover { border-color: var(--color-cta); }

  /* ── 邀請好友 ──────────────────────────────────────────────────────── */
  .member-page .referral-code-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .member-page .referral-code-box { display: grid; gap: 2px; }
  .member-page .referral-code-label { color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .referral-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 22px; letter-spacing: 3px; color: var(--color-ink); }
  .member-page .referral-actions { display: flex; gap: 8px; }
  .member-page .referral-btn { display: inline-flex; align-items: center; border: 0; border-radius: 999px; padding: 9px 20px; background: var(--color-cta); color: var(--color-cta-text); font: inherit; font-size: var(--meta-text-size); cursor: pointer; }
  .member-page .referral-btn:hover { opacity: 0.88; }
  .member-page .referral-btn-line { background: var(--color-line); }
  .member-page .referral-stats { display: flex; gap: 24px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--color-border); flex-wrap: wrap; }
  .member-page .referral-stat { display: grid; gap: 2px; }
  .member-page .referral-stat .k { color: var(--text-muted); font-size: var(--meta-text-size); }
  .member-page .referral-stat .v { font-family: var(--font-serif); font-size: 18px; color: var(--color-ink); }

  @media (max-width: 1023px) {
    .member-page .member-grid { grid-template-columns: 1fr; }
    .member-page .side { position: static; }
